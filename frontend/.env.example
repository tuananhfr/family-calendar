# Backend target used by `next dev` rewrites for /api/*
DEV_API_TARGET=http://127.0.0.1:3005

# Public HTTPS origin used by canonical, social metadata and sitemap (no path).
NEXT_PUBLIC_SITE_ORIGIN=https://lpc.vn
# Set to /lich-gia-dinh for the production sub-path; leave empty for domain-root hosting.
NEXT_PUBLIC_BASE_PATH=
