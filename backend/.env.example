# Copy to .env for local development. Never commit .env.
PORT=3005
HOST=127.0.0.1
API_ORIGIN=http://127.0.0.1:3005
# Comma-separated list allowed on write requests (Origin check).
FRONTEND_ORIGIN=http://localhost:3004,http://127.0.0.1:3004
# Sub-path the app is served under (e.g. /lich-gia-dinh), empty at the domain root. Must equal the frontend's
# NEXT_PUBLIC_BASE_PATH; links in mail/invites/ICS become <FRONTEND_ORIGIN|API_ORIGIN><PUBLIC_BASE_PATH>/...
PUBLIC_BASE_PATH=

# MariaDB 11.4 on 3307 (NOT the MySQL server on 3306). DB_PASSWORD must be present even if empty.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=family_calendar

COOKIE_SECURE=false
SESSION_TTL_DAYS=90
# Multiplier for every rate limit (keep 1 outside test suites).
RATE_LIMIT_SCALE=1

STORAGE_DIR=var/storage
# Required, 64 hex chars. Generate with: node scripts/gen-keys.mjs
STORAGE_MASTER_KEY=
# Per-file upload caps in bytes: images/documents/audio 25 MB, video 200 MB.
STORAGE_MAX_FILE_BYTES=26214400
STORAGE_MAX_VIDEO_BYTES=209715200

# Web Push (filled by scripts/gen-vapid.mjs once that task lands).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# file = write .eml into MAIL_DIR (dev); smtp requires SMTP_URL.
MAIL_TRANSPORT=file
MAIL_DIR=var/mail
SMTP_URL=
MAIL_FROM=Lich Gia Dinh <no-reply@example.com>

# Leave empty to keep the assistant in "not configured" state.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# fake = offline scripted assistant for E2E/dev (no API key, no network); anthropic = real Claude API.
AI_PROVIDER=anthropic
# Conversations are deleted this many days after their last message.
AI_RETENTION_DAYS=30

RUN_WORKER_IN_PROCESS=false

# Cursors older than this many days must take a fresh snapshot; one snapshot holds at most this many records.
SYNC_TOMBSTONE_DAYS=90
SYNC_SNAPSHOT_MAX_RECORDS=20000
