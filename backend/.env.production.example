NODE_ENV=production
PORT=3005
HOST=127.0.0.1
API_ORIGIN=https://lichgiadinh.info
FRONTEND_ORIGIN=https://lichgiadinh.info
PUBLIC_BASE_PATH=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=family_calendar
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_NAME=family_calendar
COOKIE_SECURE=true
SESSION_TTL_DAYS=90
RATE_LIMIT_SCALE=1
STORAGE_DIR=/var/www/family-calendar/backend/var/storage
# Existing installation: KEEP its existing key. New installation only: node scripts/gen-keys.mjs.
STORAGE_MASTER_KEY=CHANGE_ME_EXISTING_OR_NEW_64_HEX_KEY
RUN_WORKER_IN_PROCESS=false
MAIL_TRANSPORT=smtp
SMTP_URL=smtps://CHANGE_ME:CHANGE_ME@mail.example.invalid:465
MAIL_FROM=Lich Gia Dinh <no-reply@lichgiadinh.info>
# Optional: keep/configure existing VAPID and AI values if those features are used.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@lichgiadinh.info
